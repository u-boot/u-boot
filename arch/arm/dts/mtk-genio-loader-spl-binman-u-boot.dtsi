/* Include within a section: the loader and SPL form one contiguous payload. */
ddr-loader {
	type = "blob-ext";
	filename = "ddr-loader.bin";
	size = <CONFIG_MTK_GENIO_DDR_LOADER_SIZE>;
};

u-boot-spl {
	size = <CONFIG_SPL_MAX_SIZE>;
};
