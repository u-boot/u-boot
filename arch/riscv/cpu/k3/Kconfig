if TARGET_SPACEMIT_K3

config SPACEMIT_K3
	bool
	select BINMAN
	select ARCH_EARLY_INIT_R
	select SYS_CACHE_SHIFT_6
	imply CPU
	imply CPU_RISCV
	imply RISCV_TIMER if RISCV_SMODE
	imply CMD_CPU
	imply OF_UPSTREAM

endif
